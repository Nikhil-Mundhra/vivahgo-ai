# VivahGo AI — Environment Configuration for Deployment

# 1. Frontend (Next.js on Vercel)
AGENT_ORCHESTRATOR_URL=http://localhost:8000/api/chat
JWT_SECRET=change-me-before-production
NEXT_PUBLIC_APP_URL=https://ai.vivahgo.com
NEXT_PUBLIC_MOBILE_APP_URL=https://vivahgo.com

# 2. Agent (Python / LangGraph)
MCP_SERVER_URL=http://localhost:4567/mcp
PORT=8000

# 3. Backend (Java 21 / SparkJava / jOOQ -> Neon Lakebase Postgres)
# Pooled (-pooler) Neon connection string for runtime traffic
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/vivahgo_db?sslmode=require&channel_binding=require"
# Direct (non-pooled) Neon connection string for schema migrations / DDL
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/vivahgo_db?sslmode=require&channel_binding=require"
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=4567
